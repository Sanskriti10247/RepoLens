# Copy to .env and adjust. Never commit .env.
REPOLENS_ENVIRONMENT=development
REPOLENS_DATABASE_URL=postgresql+psycopg://repolens:repolens@127.0.0.1:5433/repolens
REPOLENS_API_HOST=127.0.0.1
REPOLENS_API_PORT=8100
# Required for mutating endpoints (repository registration, analyses, test runs).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
REPOLENS_API_TOKEN=
REPOLENS_DATA_DIR=var
# Per-user sign-in with Supabase Auth (docs/deployment.md, "Sign-in with Supabase"). When set,
# every route except /api/health and /api/ready needs a signed-in user's access token, and
# each user sees only the repositories they added. REPOLENS_API_TOKEN is then not used.
# REPOLENS_SUPABASE_URL=https://<project-ref>.supabase.co
# Only for projects that still sign tokens with the legacy shared JWT secret:
# REPOLENS_SUPABASE_JWT_SECRET=
# Web app (apps/web): both set turns on the Google sign-in page.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Refuse every mutation and need no worker or token (a showcase).
# REPOLENS_READ_ONLY=true
# Without a Docker daemon: refuse test runs and collection; test plans still work.
# REPOLENS_SANDBOX_ENABLED=false
REPOLENS_LOG_LEVEL=INFO
REPOLENS_LOG_FORMAT=console

# Production (docker-compose.prod.yml, see docs/deployment.md). Copy to .env.prod (gitignored)
# and pass --env-file .env.prod. The containers override the development settings above.

# URL-safe, because it is embedded in the connection URL:
#   python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=
# Absolute host path for mirrors and test workspaces. Mounted at the same path in the worker
# and must be writable by REPOLENS_APP_UID.
REPOLENS_HOST_DATA_DIR=/var/lib/repolens
# Group id that owns the Docker socket on the host: stat -c %g /var/run/docker.sock
REPOLENS_DOCKER_GID=
# Non-root user for api and worker. Must own REPOLENS_HOST_DATA_DIR.
REPOLENS_APP_UID=10010
REPOLENS_APP_GID=10010
# Loopback port for the web app; the reverse proxy connects to it.
REPOLENS_WEB_PORT=3100
# Optional Caddy service (--profile tls): public DNS name and basic auth.
REPOLENS_PUBLIC_HOST=
REPOLENS_BASIC_AUTH_USER=
REPOLENS_BASIC_AUTH_HASH=
# Names and tag for the built images.
REPOLENS_IMAGE_PREFIX=repolens
REPOLENS_IMAGE_TAG=latest
